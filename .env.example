# Copy to .env.local (never committed). Used by `npm run dev`; for the live site set
# these as Cloudflare Worker secrets instead (see worker/README.md).

# From ollama.com/settings/keys. Powers the AI chat, the job finder's web search and
# the HR email lookup.
OLLAMA_API_KEY=
# The access code the chat asks for before unlocking owner mode (JARVIS).
OWNER_PASSCODE=
